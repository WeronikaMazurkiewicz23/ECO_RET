                &#x9;WHEN&#xd;&#xa;                   &#x9;              &quot;pole&quot; >= 1000&#xd;&#xa;                                 &#x9;AND &quot;Access_4&quot; = 'Access_to_stops'&#xd;&#xa;                                 &#x9;AND &quot;Access_5&quot; = 'Access_to_public_spaces'&#xd;&#xa;                                 &#x9;AND @uslugi_mpzp&#xd;&#xa;                             &#x9;THEN 'Eco-markets'&#xd;&#xa;                             &#x9;ELSE NULL&#xd;&#xa;                         &#x9;END,&#xd;&#xa;&#xd;&#xa;                         &#x9;CASE&#xd;&#xa;                             &#x9;WHEN &quot;area&quot; >= 2000&#xd;&#xa;                             &#x9;THEN 'Large-scale photovoltaic power generation'&#xd;&#xa;                             &#x9;ELSE NULL&#xd;&#xa;                         &#x9;END,&#xd;&#xa;&#xd;&#xa;                         &#x9;CASE&#xd;&#xa;                             &#x9;WHEN &quot;area&quot; >= 2000&#xd;&#xa;                             &#x9;THEN 'Large-scale biogas production'&#xd;&#xa;                             &#x9;ELSE NULL&#xd;&#xa;                         &#x9;END,&#xd;&#xa;&#xd;&#xa;                         &#x9;CASE&#xd;&#xa;                             &#x9;WHEN&#xd;&#xa;                                     &quot;GRUPA_REJE&quot; IN ('1','2','3','4')&#xd;&#xa;                                 &#x9;AND &quot;area&quot; >= 500&#xd;&#xa;                                 &#x9;AND &quot;Access&quot; = 'Access_to_managed_green'&#xd;&#xa;                             &#x9;THEN 'Public managed green spaces'&#xd;&#xa;                             &#x9;ELSE NULL&#xd;&#xa;                         &#x9;END,&#xd;&#xa;&#xd;&#xa;                         &#x9;CASE&#xd;&#xa;                             &#x9;WHEN&#xd;&#xa;                                     &quot;area&quot; >= 500&#xd;&#xa;                                 &#x9;AND &quot;Access&quot; = 'Access_to_managed_green'&#xd;&#xa;                             &#x9;THEN 'Water reservoirs and rain gardens'&#xd;&#xa;    &#x9;                         ELSE NULL&#xd;&#xa;                         &#x9;END,&#xd;&#xa;&#xd;&#xa;                         &#x9;CASE&#xd;&#xa;                             &#x9;WHEN&#xd;&#xa;                                     &quot;area&quot; >= 2000&#xd;&#xa;                                 &#x9;AND &quot;GRUPA_REJE&quot; NOT IN ('5','6','7','8','9')&#xd;&#xa;                                 &#x9;AND &quot;Access_5&quot; = 'Access_to_public_spaces'&#xd;&#xa;                             &#x9;THEN 'Zero-energy public-transport interchange'&#xd;&#xa;                             &#x9;ELSE NULL&#xd;&#xa;         &#x9;                END,&#xd;&#xa;&#xd;&#xa;                         &#x9;CASE&#xd;&#xa;                             &#x9;WHEN&#xd;&#xa;                                     &quot;GRUPA_REJE&quot; NOT IN ('5','6','7','8','9')&#xd;&#xa;                                 &#x9;AND &quot;Access_5&quot; = 'Access_to_public_spaces'&#xd;&#xa;                             &#x9;THEN 'Street with a pedestrian and cycle route and an avenue of trees'&#xd;&#xa;                             &#x9;ELSE NULL&#xd;&#xa;                         &#x9;END,&#xd;&#xa;&#xd;&#xa;                         &#x9;CASE&#xd;&#xa;                             &#x9;WHEN&#xd;&#xa;        &#x9;                         &quot;area&quot; >= 1000&#xd;&#xa;                                 &#x9;AND @pelne_dostepy&#xd;&#xa;                             &#x9;THEN 'Low-emission housing'&#xd;&#xa;                             &#x9;ELSE NULL&#xd;&#xa;                         &#x9;END,&#xd;&#xa;&#xd;&#xa;                         &#x9;CASE&#xd;&#xa;                             &#x9;WHEN&#xd;&#xa;                                     &quot;area&quot; >= 2000&#xd;&#xa;                                 &#x9;AND @pelne_dostepy&#xd;&#xa;                             &#x9;THEN 'Housing cooperatives – bottom-up development'&#xd;&#xa;               &#x9;              ELSE NULL&#xd;&#